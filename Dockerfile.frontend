# Frontend build stage (Dockerfile.frontend)
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

# Deps first — solo se reinstala si cambia package.json/lockfile, no en cada
# cambio de código fuente (antes el COPY de todo el dir invalidaba esta capa).
# --ignore-scripts: el postinstall (build:icons) necesita src/, que todavía no
# está copiado; se corre explícito abajo.
COPY frontend_materio/package.json frontend_materio/package-lock.json* frontend_materio/pnpm-lock.yaml* ./
RUN npm ci --ignore-scripts || npm install --ignore-scripts

# Ahora el código
COPY frontend_materio/ ./

# Build (íconos + app)
RUN npm run build:icons && npm run build

# Output: /frontend/dist ready for Nginx
# Built output will be mounted to SPA volume via docker-compose
